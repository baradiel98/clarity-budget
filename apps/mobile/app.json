{
  "expo": {
    "name": "Clarity",
    "slug": "clarity-budget",
    "scheme": "clarity",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F2F6FC",
    "updates": { "enabled": false },
    "ios": {
      "bundleIdentifier": "app.clarity.budget.dev",
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Unlock Clarity with Face ID instead of typing your passphrase."
      }
    },
    "android": {
      "package": "app.clarity.budget.dev",
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#2559DB" },
      "allowBackup": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      ["expo-secure-store", { "faceIDPermission": "Unlock Clarity with Face ID instead of typing your passphrase." }],
      ["expo-local-authentication", { "faceIDPermission": "Unlock Clarity with Face ID instead of typing your passphrase." }],
      ["expo-splash-screen", { "image": "./assets/splash-icon.png", "imageWidth": 120, "backgroundColor": "#F2F6FC", "dark": { "backgroundColor": "#0A0F19" } }],
      "expo-font",
      ["@react-native-community/datetimepicker", {}]
    ],
    "experiments": { "typedRoutes": false }
  }
}
