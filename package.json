{
  "name": "clarity-budget",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.dom.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint packages apps/web/src apps/web/e2e",
    "bench:kdf": "node --experimental-strip-types scripts/kdf-benchmark.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build -w @clarity/web"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.0",
    "hash-wasm": "^4.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}